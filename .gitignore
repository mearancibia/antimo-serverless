# Credenciales y datos sensibles — NUNCA subir
datos/bistro_config.json
datos/bistro_debug.json

# Generados automáticamente (se regeneran)
dashboard_ANTIMO.html
datos_dashboard.json
datos_general_actualizado.xlsx

# Ventas/cajas (datos reales del negocio, no código) — de la API o cargadas a mano
entrada/api_ventas_*.xlsx
datos/cajas_api.json

# Config local de Claude Code (permisos de sesion, no es parte del proyecto)
**/.claude/settings.local.json

# Paquete armado para instalar en otra Mac: es una COPIA del propio proyecto
# (+ un ZIP binario y un .git anidado). Versionarlo duplicaria el repo en cada
# rearmado y los binarios no se pueden sacar despues del historial.
SISTEMITA_LISTO/

# Backups y temporales
datos/*backup*.xlsx
datos/_backups/
__pycache__/
_dbg.py
*.pyc
.DS_Store

# Migración Vercel + Supabase: credenciales y entorno, nunca a git
.env
.env.*
!.env.example
venv/
.venv/
.vercel/

# Archivo: legado pre-ANTIMO y cosas superadas por mejoras posteriores.
