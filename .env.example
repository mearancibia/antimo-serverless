# Copiá este archivo a .env (local) o cargá estas variables en el proyecto de Vercel.
# NUNCA subas el .env real a git (ya está en .gitignore).

# URL del proyecto de Supabase (Settings → API)
SUPABASE_URL=https://xxxxxxxx.supabase.co

# Service role key (Settings → API → service_role, NO la "anon"). Los endpoints en /api
# corren server-side en Vercel, nunca en el navegador, así que es seguro usarla acá.
SUPABASE_SERVICE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
