# Copiá este archivo a .env (local) o cargá estas variables en el proyecto de Vercel.
# NUNCA subas el .env real a git (ya está en .gitignore).

# URL del proyecto de Supabase (Settings → API)
SUPABASE_URL=https://xxxxxxxx.supabase.co

# Service role key (Settings → API → service_role, NO la "anon"). Los endpoints en /api
# corren server-side en Vercel, nunca en el navegador, así que es seguro usarla acá.
SUPABASE_SERVICE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Token del relay de impresión (scripts/print_relay.js). Va en Vercel Y en la PC del bar: los
# dos tienen que tener EXACTAMENTE el mismo valor. Generalo con:
#     python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Si NO se define, los endpoints del relay quedan cerrados (falla cerrada, ver auth.py). O sea:
# dejarlo vacío desactiva la impresión por relay, no la abre a cualquiera.
# Su alcance es mínimo: sólo lee la cola de impresión y la marca impresa. No da acceso a ventas,
# costos, OPEX ni usuarios.
PRINT_RELAY_TOKEN=
